# Servidor
PORT=8080

# Intervalo (em segundos) usado para:
#  - TTL do cache de odds em memória
#  - Intervalo de polling/broadcast de partidas e odds via WebSocket
# Recomendado: 20 a 60s. Mínimo 5s, máximo 600s.
CACHE_TTL_SECONDS=60

# Fuso horário em horas (Brasil: -3)
TIMEZONE_OFFSET=-3

# APIs externas (opcionais — defaults já apontam para os endpoints da spec)
SUPER_SCORE_BASE_URL=https://api.content-prod.superscore.live
SUPERBET_BASE_URL=https://production-superbet-offer-br.freetls.fastly.net
SUPER_SCORE_BOOKMAKER_ID=76
SUPER_SCORE_SPORT_ID=1
SUPER_SCORE_LANGUAGE=pt-BR
